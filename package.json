{
  "name": "bgssai-compositor",
  "version": "0.1.0",
  "description": "An offline layer-based image editor for Windows",
  "private": true,
  "type": "module",
  "author": "BGSSAI",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/project.test.ts",
    "test:e2e": "playwright test",
    "test:dev": "node scripts/smoke-dev.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "test:portable": "node scripts/smoke-portable.mjs",
    "check": "npm run test && npm run build && npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win --x64",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "com.bgssai.compositor",
    "productName": "BGSSAI Compositor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BGSSAI-Compositor-${version}-win-${arch}-setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "BGSSAI-Compositor-${version}-win-${arch}-portable.exe"
    }
  }
}
